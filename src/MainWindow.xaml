<Window x:Class="PRomda.FileShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRomda FileShare" Width="1080" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="16,0"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#171717"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="#303030"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}"><Setter Property="Background" Value="#F0F0F0"/><Setter Property="Foreground" Value="#080808"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="WindowBtn" TargetType="Button"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#AAA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/></Style>
        <Style TargetType="TextBox"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="#090909"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#292929"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="#080808"/><Setter Property="Foreground" Value="#EEE"/><Setter Property="BorderBrush" Value="#252525"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Window.Resources>
    <Border Background="#050505" BorderBrush="#191919" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#050505" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid><TextBlock Text="PRomda FileShare" Foreground="#EEE" VerticalAlignment="Center" Margin="16,0" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0"><Button Content="□" Style="{StaticResource WindowBtn}" Click="Maximize_Click"/><Button Content="×" Style="{StaticResource WindowBtn}" Click="Close_Click"/></StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Border x:Name="AccessToast" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14" Width="340" Padding="14" Background="#0B0B0B" BorderBrush="#333" BorderThickness="1" CornerRadius="10" Panel.ZIndex="100" Visibility="Collapsed">
                    <StackPanel><TextBlock Text="Запрос на доступ" Foreground="White" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Пользователь хочет подключиться к вашим файлам" Foreground="#AAA" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock x:Name="AccessToastUser" Foreground="White" Margin="0,6,0,0"/><TextBlock x:Name="AccessToastCode" Foreground="#777" FontSize="10" Margin="0,2,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отклонить" Style="{StaticResource Btn}" Height="30" Padding="10,0" Click="AccessDeny_Click"/><Button Content="Разрешить" Style="{StaticResource Primary}" Height="30" Padding="12,0" Margin="0" Click="AccessAllow_Click"/></StackPanel></StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <Grid Margin="24,20,24,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Обмен файлами" Foreground="#F2F2F2" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Напрямую между компьютерами · без регистрации" Foreground="#777" FontSize="12" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0C0C0C" BorderBrush="#222" BorderThickness="1" CornerRadius="7" Padding="10,6"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#777" Margin="0,0,7,0"/><TextBlock x:Name="Status" Text="OFFLINE" Foreground="#AAA" FontSize="11"/></StackPanel></Border></Grid>
                        <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#222" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Код библиотеки" Foreground="#777" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="CodeBox"/></StackPanel><Button Grid.Column="1" Content="Подключиться" Style="{StaticResource Primary}" Margin="12,17,0,0" Click="Connect_Click"/><Button Grid.Column="2" Content="Создать библиотеку" Style="{StaticResource Btn}" Margin="2,17,0,0" Click="Create_Click"/></Grid></Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <Border Background="#090909" BorderBrush="#222" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,9,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Моя библиотека" Foreground="#F0F0F0" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Row="0" x:Name="MyCode" Text="Код: —" Foreground="#777" FontSize="11" Margin="0,25,0,0"/><Border Grid.Row="1" Margin="0,16,0,11" Background="#070707" BorderBrush="#252525" BorderThickness="1" CornerRadius="9" Padding="16" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"><StackPanel HorizontalAlignment="Center"><TextBlock Text="↓" Foreground="#EEE" FontSize="26" HorizontalAlignment="Center"/><TextBlock Text="Перетащите файлы сюда" Foreground="#EEE" FontSize="14" HorizontalAlignment="Center"/><TextBlock Text="Файлы попадут в Документы\FPI" Foreground="#666" FontSize="11" Margin="0,5,0,12"/><Button Content="Выбрать файлы" Style="{StaticResource Btn}" Height="36" Click="PickFiles_Click"/></StackPanel></Border><Grid Grid.Row="2" Margin="0,0,0,9"><StackPanel><TextBlock Text="Хранилище FPI" Foreground="#777" FontSize="11"/><TextBlock x:Name="FolderText" Text="Документы\FPI" Foreground="#CCC" FontSize="11"/></StackPanel><Button Content="Очистить всё" Style="{StaticResource Btn}" Height="30" HorizontalAlignment="Right" Padding="10,0" Click="ClearAllFiles_Click"/></Grid><ListBox Grid.Row="3" x:Name="LocalFilesList" MinHeight="145"/></Grid></Border>
                            <Border Grid.Column="1" Background="#090909" BorderBrush="#222" BorderThickness="1" CornerRadius="10" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Подключённая библиотека" Foreground="#F0F0F0" FontSize="18" FontWeight="SemiBold"/><ListBox Grid.Row="1" x:Name="FilesList" Margin="0,13,0,11" MinHeight="190"/><StackPanel Grid.Row="2"><Button Content="Скачать все файлы" Style="{StaticResource Primary}" Height="38" Margin="0,0,0,9" Click="DownloadAll_Click"/><TextBlock x:Name="RemoteStatus" Foreground="#777" TextWrapping="Wrap" FontSize="11"/></StackPanel></Grid></Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
