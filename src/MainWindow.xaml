<Window x:Class="PRomda.FileShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRomda FileShare"
        Width="1080" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="28"/><Setter Property="Margin" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#1B1B1B"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#252525"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="18,0"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#F2F2F2"/><Setter Property="Foreground" Value="#080808"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#CFCFCF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#101010"/><Setter Property="Foreground" Value="#E6E6E6"/><Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="#252525" BorderThickness="1" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#171717"/><Setter TargetName="Root" Property="BorderBrush" Value="#3A3A3A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#0A0A0A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="13,0"/><Setter Property="Background" Value="#090909"/><Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="BorderBrush" Value="#262626"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="#080808"/><Setter Property="Foreground" Value="#EDEDED"/><Setter Property="BorderBrush" Value="#202020"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,1"/><Setter Property="Foreground" Value="#DCDCDC"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemRoot" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#121212"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#1B1B1B"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Window.Resources>

    <Border Background="#050505" CornerRadius="10" BorderBrush="#191919" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#050505" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="PRomda FileShare" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#EDEDED" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,7,0">
                        <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"/>
                        <Button Content="□" Style="{StaticResource WindowButton}" Click="Maximize_Click"/>
                        <Button Content="×" Style="{StaticResource WindowButton}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="AccessToast" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14,0,0" Width="340" Padding="14" Background="#0B0B0B" BorderBrush="#2B2B2B" BorderThickness="1" CornerRadius="10" Panel.ZIndex="100" Visibility="Collapsed">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Запрос на доступ" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="1" Margin="0,7,0,12"><TextBlock Text="Пользователь хочет подключиться к вашим файлам" Foreground="#BDBDBD" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="AccessToastUser" Text="Пользователь" Foreground="#EEEEEE" FontSize="12" Margin="0,5,0,0"/><TextBlock x:Name="AccessToastCode" Text="Код: —" Foreground="#666666" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отклонить" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Margin="0,0,7,0" Click="AccessDeny_Click"/><Button Content="Разрешить" Style="{StaticResource PrimaryButton}" Height="30" Padding="14,0" Margin="0" Click="AccessAllow_Click"/></StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24,20,24,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Обмен файлами" Foreground="#F2F2F2" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Напрямую между компьютерами · без регистрации" Foreground="#777777" FontSize="12" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0C0C0C" BorderBrush="#1E1E1E" BorderThickness="1" CornerRadius="7" Padding="10,6"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#5FD49A" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="Status" Text="OFFLINE" Foreground="#A9A9A9" FontSize="11" FontWeight="SemiBold"/></StackPanel></Border></Grid>
                    <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Код библиотеки" Foreground="#777777" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="CodeBox" Text=""/></StackPanel><Button Grid.Column="1" Content="Подключиться" Style="{StaticResource PrimaryButton}" Margin="12,17,0,0" Click="Connect_Click"/><Button Grid.Column="2" Content="Создать библиотеку" Style="{StaticResource SecondaryButton}" Margin="2,17,0,0" Click="Create_Click"/></Grid></Border>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                        <Border Background="#090909" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,9,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="Моя библиотека" Foreground="#F0F0F0" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="MyCode" Text="Код: —" Foreground="#6F6F6F" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                            <Border Grid.Row="1" Margin="0,16,0,11" Background="#070707" BorderBrush="#202020" BorderThickness="1" CornerRadius="9" Padding="16" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"><StackPanel HorizontalAlignment="Center"><Border Width="38" Height="38" CornerRadius="10" Background="#111111" BorderBrush="#232323" BorderThickness="1"><TextBlock Text="↓" Foreground="#EAEAEA" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Перетащите файлы сюда" Foreground="#E8E8E8" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="Файлы автоматически попадут в Документы\FPI" Foreground="#666666" FontSize="11" Margin="0,5,0,12" HorizontalAlignment="Center"/><Button Content="Выбрать файлы" Style="{StaticResource SecondaryButton}" Height="36" Padding="15,0" HorizontalAlignment="Center" Click="PickFiles_Click"/></StackPanel></Border>
                            <Grid Grid.Row="2" Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Хранилище FPI" Foreground="#707070" FontSize="11"/><TextBlock x:Name="FolderText" Text="Документы\FPI" Foreground="#CFCFCF" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="Очистить всё" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="8,0,0,0" Click="ClearAllFiles_Click"/></Grid>
                            <ListBox Grid.Row="3" x:Name="LocalFilesList" MinHeight="145"/>
                        </Grid></Border>
                        <Border Grid.Column="1" Background="#090909" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="10" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Подключённая библиотека" Foreground="#F0F0F0" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Доступные файлы" Foreground="#6F6F6F" FontSize="11" Margin="0,5,0,0"/></StackPanel><ListBox Grid.Row="1" x:Name="FilesList" Margin="0,13,0,11" MinHeight="190"/><StackPanel Grid.Row="2"><Button Content="Скачать выбранный файл" Style="{StaticResource PrimaryButton}" Height="38" Margin="0,0,0,9" Click="Download_Click"/><TextBlock x:Name="RemoteStatus" Foreground="#777777" TextWrapping="Wrap" FontSize="11"/></StackPanel></Grid></Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>